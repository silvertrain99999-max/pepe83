  "rules": [
    {
      "id": "legacy_eagle",
      "rule": "기존 XX1/X01/GX/NX/SX Eagle 12단은 MTB/12단 S-Series에 포함",
      "basis": "user_override"
    },
    {
      "id": "transmission",
      "rule": "트랜스미션/T-Type 구동부품과 POD 컨트롤러 본체는 MTB/12단 트랜스미션"
    },
    {
      "id": "dedicated_parts",
      "rule": "체인링, BB, 보수부품은 해당 전용 분류 우선"
    },
    {
      "id": "axs_sets",
      "rule": "로드 AXS 변속·브레이크 통합 세트는 로드/eTap AXS"
    },
    {
      "id": "third_party",
      "rule": "타사 호환품은 SRAM 정품과 구분하고 포함 여부 별도 결정"
    },
    {
      "id": "discontinued",
      "rule": "단종은 카테고리와 별도 기록. 정확한 모델·세대·옵션 및 공급 재고 확인. 단종만으로 삭제하지 않음"
    },
    {
      "id": "independent_channels",
      "rule": "양 채널 분류 기준은 같지만 수정·판매상태·재고는 각각 확인"
    },
    {
      "id": "verification",
      "rule": "한글·영문 표기 모두 검색. 검색 0건은 단종/미등록 확정 근거가 아님. 전수 검증 전 완전 목록으로 단정하지 않음"
    }
  ],
